<Window x:Class="CybersecurityChatbotPartTwo.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:CybersecurityChatbotPartTwo"
        mc:Ignorable="d"
        Title="Cybersecurity Awareness Chatbot"
        Height="650"
        Width="550"
        WindowStartupLocation="CenterScreen"
        Background="#1E1E2E"
        Loaded="Window_Loaded">

	<Window.Resources>
		<!-- Style for user messages (blue bubble on right side) -->
		<Style x:Key="UserBubble" TargetType="Border">
			<Setter Property="Background" Value="#4A90D9"/>
			<Setter Property="CornerRadius" Value="15"/>
			<Setter Property="Padding" Value="12,8"/>
			<Setter Property="Margin" Value="50,5,10,5"/>
			<Setter Property="BorderThickness" Value="0"/>
		</Style>

		<!-- Style for bot messages (dark bubble on left side) -->
		<Style x:Key="BotBubble" TargetType="Border">
			<Setter Property="Background" Value="#2D2D3D"/>
			<Setter Property="CornerRadius" Value="15"/>
			<Setter Property="Padding" Value="12,8"/>
			<Setter Property="Margin" Value="10,5,50,5"/>
			<Setter Property="BorderThickness" Value="1"/>
			<Setter Property="BorderBrush" Value="#4A90D9"/>
		</Style>
	</Window.Resources>

	<Grid>
		<!-- MAIN CONTAINER - Full height -->
		<Grid.RowDefinitions>
			<RowDefinition Height="Auto"/>
			<RowDefinition Height="*"/>
			<RowDefinition Height="Auto"/>
			<RowDefinition Height="Auto"/>
		</Grid.RowDefinitions>

		<!-- ===== LOADING OVERLAY (Shows during voice) ===== -->
		<Grid x:Name="LoadingOverlay"
              Grid.RowSpan="4"
              Background="#1E1E2E"
              Visibility="Visible"
              Panel.ZIndex="100">
			<StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
				<TextBlock x:Name="SplashLogo"
                           FontFamily="Consolas"
                           FontSize="9"
                           Foreground="#4A90D9"
                           TextWrapping="Wrap"
                           Text="Loading logo..."
                           HorizontalAlignment="Center"/>
				<TextBlock Text="Cybersecurity Awareness Assistant"
                           FontSize="16"
                           FontWeight="Bold"
                           Foreground="White"
                           HorizontalAlignment="Center"
                           Margin="0,20,0,0"/>
				<TextBlock x:Name="LoadingStatus"
                           Text="🔊 Playing welcome message..."
                           FontSize="12"
                           Foreground="#888888"
                           HorizontalAlignment="Center"
                           Margin="0,15,0,0"/>
			</StackPanel>
		</Grid>

		<!-- ===== MAIN INTERFACE (Hidden until voice done) ===== -->
		<Grid x:Name="MainInterface"
              Grid.RowSpan="4"
              Visibility="Collapsed">
			<Grid.RowDefinitions>
				<RowDefinition Height="Auto"/>
				<RowDefinition Height="*"/>
				<RowDefinition Height="Auto"/>
				<RowDefinition Height="Auto"/>
			</Grid.RowDefinitions>

			<!-- HEADER SECTION (Row 0) -->
			<Border Grid.Row="0" Background="#2D2D3D" Padding="10">
				<StackPanel>
					<TextBlock x:Name="AsciiLogo"
                               FontFamily="Consolas"
                               FontSize="9"
                               Foreground="#4A90D9"
                               TextWrapping="Wrap"
                               Text=""
                               HorizontalAlignment="Center"/>
					<TextBlock Text="Cybersecurity Awareness Assistant"
                               FontSize="14"
                               FontWeight="Bold"
                               Foreground="White"
                               HorizontalAlignment="Center"
                               Margin="0,5,0,0"/>
				</StackPanel>
			</Border>

			<!-- TabControl -->
			<TabControl Grid.Row="1"
						Background="#1E1E2E"
						BorderThickness="0">
				<!-- CHAT TAB -->
				<TabItem Header="💬 Chat"
						 Background="#2D2D3D"
						 Foreground="White">
					<Grid>
						<Grid.RowDefinitions>
							<RowDefinition Height="*"/>
							<RowDefinition Height="Auto"/>
						</Grid.RowDefinitions>
						<ScrollViewer x:Name="ChatScrollViewer"
									  Grid.Row="0"
									  VerticalScrollBarVisibility="Auto"
									  Background="#1E1E2E">
							<StackPanel x:Name="ChatPanel"
										Margin="10"
										Orientation="Vertical"/>
						</ScrollViewer>
						<Border Grid.Row="1"
								Background="#2D2D3D"
								Padding="10"
								BorderBrush="#4A90D9"
								BorderThickness="0,1,0,0">
							<Grid>
								<Grid.ColumnDefinitions>
									<ColumnDefinition Width="*"/>
									<ColumnDefinition Width="Auto"/>
								</Grid.ColumnDefinitions>
								<TextBox x:Name="UserInputBox"
										 Grid.Column="0"
										 FontSize="14"
										 Foreground="White"
										 Background="#1E1E2E"
										 BorderBrush="#4A90D9"
										 BorderThickness="1"
										 Padding="10,8"
										 KeyDown="UserInputBox_KeyDown"/>
								<Button x:Name="SendButton"
										Grid.Column="1"
										Content="📤 SEND"
										Width="80"
										Margin="10,0,0,0"
										Background="#4A90D9"
										Foreground="White"
										FontWeight="Bold"
										FontSize="12"
										Click="SendButton_Click"/>
							</Grid>
						</Border>
					</Grid>
				</TabItem>

				<!-- TASKS TAB -->
				<TabItem Header="📋 Tasks"
						 Background="#2D2D3D"
						 Foreground="White">
					<Grid Margin="10" Background="#1E1E2E">
						<Grid.RowDefinitions>
							<RowDefinition Height="Auto"/>
							<RowDefinition Height="*"/>
							<RowDefinition Height="Auto"/>
						</Grid.RowDefinitions>
						<Border Grid.Row="0"
								Background="#2D2D3D"
								Padding="10"
								Margin="0,0,0,10"
								CornerRadius="8">
							<StackPanel>
								<TextBlock Text="Add New Task"
                                           FontWeight="Bold"
                                           Foreground="White"
                                           Margin="0,0,0,5"/>
								<TextBox x:Name="TaskTitleBox"
                                         Foreground="White"
                                         Background="#1E1E2E"
                                         BorderBrush="#4A90D9"
                                         BorderThickness="1"
                                         Padding="5" Margin="0,0,0,5"
                                         Text="Enable two-factor authentication"/>
								<TextBox x:Name="TaskDescBox"
                                         Foreground="White"
                                         Background="#1E1E2E"
                                         BorderBrush="#4A90D9"
                                         BorderThickness="1"
                                         Padding="5" Margin="0,0,0,5"
                                         Text="Set up 2FA on all accounts"/>
								<TextBox x:Name="TaskReminderBox"
                                         Foreground="White"
                                         Background="#1E1E2E"
                                         BorderBrush="#4A90D9"
                                         BorderThickness="1"
                                         Padding="5" Margin="0,0,0,5"
                                         Text="Remind me in 7 days"/>
								<Button Content="➕ Add Task"
                                        Background="#4A90D9"
                                        Foreground="White"
                                        FontWeight="Bold"
                                        Click="AddTaskButton_Click"/>
							</StackPanel>
						</Border>
						<!-- Task List -->
						<ListBox x:Name="TaskListBox"
                                 Grid.Row="1"
                                 Background="#1E1E2E"
                                 BorderBrush="#4A90D9"
                                 Foreground="White"
                                 Margin="0,0,0,10">
							<ListBox.ItemTemplate>
								<DataTemplate>
									<Border Background="#2D2D3D"
                                            CornerRadius="5"
                                            Padding="5"
                                            Margin="2">
										<StackPanel>
											<TextBlock Text="{Binding Title}"
                                                       FontWeight="Bold"
                                                       Foreground="White"/>
											<TextBlock Text="{Binding Description}"
                                                       Foreground="#CCCCCC"
                                                       FontSize="11"/>
											<TextBlock Text="{Binding Reminder}"
                                                       Foreground="#888888"
                                                       FontSize="10"
                                                       Visibility="{Binding Reminder, Converter={StaticResource StringToVisibility}}"/>
											<TextBlock Text="✅ Completed"
                                                       Foreground="#4CAF50"
                                                       FontSize="10"
                                                       Visibility="{Binding IsComplete, Converter={StaticResource BoolToVisibility}}"/>
										</StackPanel>
									</Border>
								</DataTemplate>
							</ListBox.ItemTemplate>
						</ListBox>
						<!-- Action Buttons -->
						<StackPanel Grid.Row="2"
                                    Orientation="Horizontal"
                                    HorizontalAlignment="Center">
							<Button Content="✅ Mark Complete"
                                    Background="#4A90D9"
                                    Foreground="White"
                                    FontWeight="Bold"
                                    Margin="0,0,5,0" Click="CompleteTaskButton_Click"/>
							<Button Content="🗑️ Delete"
                                    Background="#D94A4A"
                                    Foreground="White"
                                    FontWeight="Bold"
                                    Margin="5,0,0,0" Click="DeleteTaskButton_Click"/>
						</StackPanel>
					</Grid>
				</TabItem>

				<!-- QUIZ TAB -->
				<TabItem Header="🎮 Quiz"
                         Background="#2D2D3D"
                         Foreground="White">
					<Grid Margin="10" Background="#1E1E2E">
						<Grid.RowDefinitions>
							<RowDefinition Height="Auto"/>
							<RowDefinition Height="*"/>
							<RowDefinition Height="Auto"/>
						</Grid.RowDefinitions>
						<StackPanel Grid.Row="0" Margin="0,0,0,10">
							<TextBlock x:Name="QuizQuestionText"
                                       Text="Press 'Start Quiz' to begin!"
                                       Foreground="White"
                                       FontSize="14"
                                       TextWrapping="Wrap"/>
							<TextBlock x:Name="QuizScoreText"
                                       Text="Score: 0/0"
                                       Foreground="#888888"
                                       Margin="0,5,0,0"/>
						</StackPanel>
						<!-- Options will be created dynamically in code-behind -->
						<StackPanel x:Name="QuizOptionsPanel"
                                    Grid.Row="1"
                                    Margin="0,0,0,10">
							<!-- Radio buttons will be added here -->
						</StackPanel>
						<!-- Buttons -->
						<StackPanel Grid.Row="2"
                                    Orientation="Horizontal"
                                    HorizontalAlignment="Center"
                                    Margin="0,10,0,0">
							<Button x:Name="QuizStartButton"
                                    Content="🎯 Start Quiz"
                                    Background="#4A90D9"
                                    Foreground="White"
                                    FontWeight="Bold"
                                    Margin="0,0,10,0" Click="QuizStartButton_Click"/>
							<Button x:Name="QuizSubmitButton"
                                    Content="Submit Answer"
                                    Background="#4A90D9"
                                    Foreground="White"
                                    FontWeight="Bold"
                                    Margin="0,0,10,0" Click="QuizSubmitButton_Click"
                                    Visibility="Collapsed"/>
							<Button x:Name="QuizNextButton"
                                    Content="Next Question"
                                    Background="#4A90D9"
                                    Foreground="White"
                                    FontWeight="Bold" Click="QuizNextButton_Click"
                                    Visibility="Collapsed"/>
						</StackPanel>
						<TextBlock x:Name="QuizFeedbackText"
                                   Grid.Row="2"
                                   Grid.ColumnSpan="2"
                                   Foreground="#FFD700"
                                   FontWeight="Bold" HorizontalAlignment="Center"
                                   Margin="0,40,0,0"/>
					</Grid>
				</TabItem>
			</TabControl>

			<!-- STATUS BAR (Row 3) -->
			<StatusBar Grid.Row="3" Background="#2D2D3D">
				<StatusBarItem>
					<TextBlock x:Name="StatusText"
                               Foreground="#888888"
                               FontSize="11">
						Ready to help you stay safe online
					</TextBlock>
				</StatusBarItem>
			</StatusBar>
		</Grid>
	</Grid>
</Window>